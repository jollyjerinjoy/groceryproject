<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="MultiBrowsertestSuiteGrouping" parallel="tests">
<groups><run><include name="regression"></include></run></groups>
<listeners>
<listener class-name="generateReport.Listeners"></listener>
 </listeners>
  <test thread-count="5" name="ChromeTest">
  <parameter name="browser" value="chrome"></parameter>
    <classes>
      <class name="com.demogrocery.app.AppTest"/>
      <class name="testscript.LoginTest"/>
      <class name="testscript.NewsTest"/>
      <class name="testscript.LogoutTest"/>
      <class name="testscript.AdminTest"/>
      <class name="testscript.FooterTextTest"/>
      <class name="testscript.ContactTest"/>
      <class name="testscript.CategoryTest"/>
    </classes>
      </test> <!-- Test -->
  <test thread-count="5" name="FirefoxTest">
  <parameter name="browser" value="firefox"></parameter>
    <classes>
      <class name="com.demogrocery.app.AppTest"/>
      <class name="testscript.LoginTest"/>
      <class name="testscript.NewsTest"/>
      <class name="testscript.LogoutTest"/>
      <class name="testscript.AdminTest"/>
      <class name="testscript.FooterTextTest"/>
      <class name="testscript.ContactTest"/>
      <class name="testscript.CategoryTest"/>
    </classes>
      </test>      
</suite> <!-- Suite -->
